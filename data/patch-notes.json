  "itemChanges": [],
  "systemChanges": [
    "造成伤害修正现已同时影响技能、普攻、装备和海克斯伤害；Riot 同时移除了大量英雄专属修正，让保留的数值更贴近英雄在海克斯大乱斗中的整体表现。"
  ],
  "systemChangesEn": [
    "Damage dealt modifiers now affect spell, attack, item, and Augment damage. Riot also removed many champion-specific modifiers so the remaining values better reflect overall ARAM: Mayhem performance."
  ],
  "mayhem": {
    "summaryZh": "26.15 的核心是统一伤害修正的覆盖范围，并重新校准英雄专属修正。会心飞弹、泰坦的坚决等高影响海克斯获得数值调整；组合玩法仍保留，但应以本次伤害值为准复核。",
    "summaryEn": "Patch 26.15 expands how damage modifiers apply and recalibrates champion-specific modifiers. High-impact Augments including Critical Missile and Titan's Resolve changed numerically; combo routes remain available but should be reviewed against the new values.",
    "augmentChanges": [
      { "name": "自适应守卫（Warding Weapon）", "nameEn": "Warding Weapon", "change": "每层提供的护甲与魔抗：5 / 6.25 / 7.5 / 8.75 / 10 → 7 / 8.25 / 9.5 / 10.75 / 12。", "changeEn": "Armor and MR per stack: 5 / 6.25 / 7.5 / 8.75 / 10 → 7 / 8.25 / 9.5 / 10.75 / 12." },
      { "name": "软泥拍抓", "nameEn": "Squishy Slappy Grab", "icon": "icons/augments/ARAMMayhemSquishySlappyGrab_arammayhem.webp", "change": "冷却时间：45 秒 → 35 秒。", "changeEn": "Cooldown: 45s → 35s." },
      { "name": "泰坦的坚决", "nameEn": "Titan's Resolve", "icon": "icons/augments/ARAMMayhemTitansResolve_arammayhem.webp", "change": "适应之力：25 / 31.25 / 37.5 / 43.75 / 50 → 25 / 37.5 / 50 / 62.5 / 75；每 10 层护甲与魔抗：4 / 5 / 6 / 7 / 8 → 5 / 6.25 / 7.5 / 8.75 / 10。", "changeEn": "Adaptive Force: 25 / 31.25 / 37.5 / 43.75 / 50 → 25 / 37.5 / 50 / 62.5 / 75. Armor and MR per 10 stacks: 4 / 5 / 6 / 7 / 8 → 5 / 6.25 / 7.5 / 8.75 / 10." },
      { "name": "执念狂热", "nameEn": "Hellbent", "icon": "icons/augments/ARAMMayhemHellbent_arammayhem.webp", "change": "冷却时间：120 秒 → 90 秒。", "changeEn": "Cooldown: 120s → 90s." },
      { "name": "大地苏醒", "nameEn": "Earthwake", "icon": "icons/augments/Earthwake_large.png", "change": "基础伤害：70 / 105 / 140 / 175 / 210 → 90 / 130 / 170 / 210 / 250。", "changeEn": "Base damage: 70 / 105 / 140 / 175 / 210 → 90 / 130 / 170 / 210 / 250." },
      { "name": "无尽屠戮", "nameEn": "Endless Decimation", "icon": "icons/augments/ARAMMayhemEndlessDecimation_arammayhem.webp", "change": "基于已损失生命值的治疗：15% → 18%。", "changeEn": "Missing-health healing: 15% → 18%." },
      { "name": "连锁反应", "nameEn": "Chain Reaction", "icon": "icons/augments/ARAMMayhemChainReaction_arammayhem.webp", "change": "终极技能触发时造成 250% 伤害。", "changeEn": "Now deals 250% damage for ultimate abilities." },
      { "name": "会心飞弹", "nameEn": "Critical Missile", "icon": "icons/augments/ARAMMayhemCriticalMissile_arammayhem.webp", "change": "每枚飞弹伤害：20 / 40 / 60 / 80 / 100 → 15 / 32.5 / 50 / 67.5 / 85。", "changeEn": "Damage per missile: 20 / 40 / 60 / 80 / 100 → 15 / 32.5 / 50 / 67.5 / 85." },
      { "name": "空降猛击", "nameEn": "Drop Bear", "icon": "icons/augments/ARAMMayhemDropbear_arammayhem.webp", "change": "眩晕：1.5 秒 → 0.5 秒；提伯斯生命值：0 / 1125 / 2250 / 3375 / 4500 → 1000 / 2375 / 3750 / 5125 / 6500。", "changeEn": "Stun: 1.5s → 0.5s. Tibbers health: 0 / 1125 / 2250 / 3375 / 4500 → 1000 / 2375 / 3750 / 5125 / 6500." },
      { "name": "拍拍背", "nameEn": "Pat on the Back", "change": "现在可被多位队友同时选择。", "changeEn": "Can now be taken by multiple teammates." },
      { "name": "仁慈一击", "nameEn": "Mercy's Strike", "icon": "icons/augments/ARAMMayhemMercysStrike_arammayhem.webp", "change": "攻击防御塔时也会消耗效果；防御塔承受相当于目标最大生命值 2.5% 的伤害。", "changeEn": "Now consumes on attacking turrets; turrets take damage equal to 2.5% of their maximum health." }
    ],
    "bugfixes": [
      "技能交互：修复维克兹 Q、艾尼维亚 Q、洛 Q 与「精准狙击」的交互问题；修复莫甘娜 R 的回声分身方向问题，以及艾克 Q 与「法术分裂」的交互。",
      "冷却与投射物：修复「巅峰发明家」与「沃格勒特的女巫帽」的冷却问题，以及图奇 R 弹体的问题。",
      "任务进度：修复米利欧 W「辅助主力」、洛 E 任务，以及剑圣 Q、佛耶戈 R 通过「潘多拉」获得位移急速的进度问题。",
      "经济与商店：修复「燃烧利息」由灼烧装备或海克斯生成金币的问题；修复「歌之权冠」在商店与出装区域的显示。",
      "分配与触发：修复「无情超载」错误影响卡特琳娜 E、萨科 E；修复「仁慈一击」会提供给非辅助英雄，以及阿克尚 E 的「自适应守卫／可靠武器」异常。",
      "其他：修复妮德丽 Q 与「飞弹分裂」、一点小帮助 VFX，以及急速追猎／力量追猎相关问题。"
    ],
    "bugfixesEn": [
      "Skill interactions: fixed Skilled Sniper with Vel'Koz Q, Anivia Q, and Rakan Q; fixed Morgana R Echo clone direction and Ekko Q with Spell Split.",
      "Cooldowns and projectiles: fixed Apex Inventor and Wooglet's Witchcap cooldown behavior, plus Twitch R bolts.",
      "Quest progress: fixed Milio W Support Main, Rakan E, and Master Yi Q / Viego R Dashing Haste progress through Pandora's Box.",
      "Economy and shop: fixed Combusting Interest gold from burn items or Augments; fixed Diadem of Songs in the shop and builds section.",
      "Offer and trigger logic: fixed Overloaded with Katarina E and Shaco E; fixed Mercy's Strike being offered to non-supports and Akshan E issues with Warding Weapon / Trusty Weapon.",
      "Other fixes: Nidalee Q with Missile Split, Lil' Extra Help VFX, and Pursuit of Haste / Power interactions."
    ]
  }
}
