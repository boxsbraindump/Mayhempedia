      { "name": "Endless Decimation", "icon": "icons/augments/ARAMMayhemEndlessDecimation_arammayhem.webp", "change": "Missing-health healing: 15% → 18%." },
      { "name": "Chain Reaction", "icon": "icons/augments/ARAMMayhemChainReaction_arammayhem.webp", "change": "Now deals 250% damage for ultimate abilities." },
